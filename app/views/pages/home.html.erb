<% content_for :title, "Fitroom" %>

<main>
  <section class="hero" aria-label="A jacket's pattern pieces drawing together into the jacket as you scroll"
           data-controller="hero" data-hero-model-value="/models/jacket.glb" data-action="pointermove->hero#move">
    <div class="hero-sticky">
      <canvas class="hero-canvas" data-hero-target="canvas"></canvas>
      <div class="hero-labels" data-hero-target="labels" aria-hidden="true"></div>

      <header class="hero-top">
        <div>
          <a class="wordmark" href="<%= root_path %>">FITROOM</a>
          <p class="mono">// Try it on before it ships</p>
          <p class="mono mono--muted">Measurements kept: none.</p>
        </div>
        <div class="hero-manifesto">
          <p class="mono">////// Manifesto</p>
          <p class="mono">Paste a jacket. Measure once.<br>See every size on a form<br>shaped like you, before you buy.</p>
        </div>
      </header>

      <footer class="hero-bottom">
        <p class="mono">Scroll down to fit.</p>
        <nav class="hero-nav">
          <a class="button button--dark" href="#fit">Find my size</a>
          <a class="button" href="#how">How it works</a>
        </nav>
      </footer>
    </div>
  </section>

  <section class="statement">
    <p class="mono">// 00 &nbsp;What it does</p>
    <p class="statement-text">Paste a jacket. Measure once. See it on a form your shape, in every size, before you buy.
      <span class="statement-muted">Nothing you type or upload is ever saved.</span></p>
  </section>

  <section class="steps" id="how">
    <article class="step">
      <p class="mono">// 01</p>
      <h2>Bring a jacket</h2>
      <p>Paste a link, paste its size chart, or use a photo and its measurements.</p>
    </article>
    <article class="step">
      <p class="mono">// 02</p>
      <h2>Measure</h2>
      <p>Five numbers with a tape measure. They shape a display form like you.</p>
    </article>
    <article class="step">
      <p class="mono">// 03</p>
      <h2>See it on</h2>
      <p>Every size on your form, where it&rsquo;s tight or loose, and what a tailor would change.</p>
    </article>
  </section>

  <section class="fitting-room" id="fit"
           data-controller="fitting-room"
           data-fitting-room-fits-url-value="<%= api_v1_fits_path %>"
           data-fitting-room-import-url-value="<%= api_v1_garment_imports_path %>"
           data-fitting-room-studio-url-value="<%= api_v1_studio_photos_path %>"
           data-fitting-room-garment-value="<%= @garment.to_json %>">
    <div class="fit-panel fit-panel--inputs">
      <div class="fit-head">
        <h2>The outfit</h2>
      </div>
      <p class="hint hint--first">A jacket, a coat over it, and trousers: add any of them. A new item replaces the one of the same kind.</p>
      <div class="outfit" data-fitting-room-target="outfitList"></div>

      <form class="link-form" data-action="submit->fitting-room#importLink">
        <label class="field-label" for="product-link">Add an item from a link</label>
        <div class="link-row">
          <input id="product-link" type="url" inputmode="url" autocomplete="off" spellcheck="false"
                 placeholder="https://shop.example/navy-blazer" data-fitting-room-target="link">
          <button type="submit" class="button button--dark" data-fitting-room-target="importButton">Add it</button>
        </div>
        <p class="link-samples">
          Try a sample:
          <button type="button" class="text-button" data-action="fitting-room#useSample" data-path="/samples/navy-suit-jacket.html">navy suit jacket</button> ·
          <button type="button" class="text-button" data-action="fitting-room#useSample" data-path="/samples/charcoal-blazer.html">charcoal blazer</button> ·
          <button type="button" class="text-button" data-action="fitting-room#useSample" data-path="/samples/grey-trousers.html">grey trousers</button>
        </p>
      </form>

      <label class="field field--compact">
        <span class="field-label">Item type</span>
        <select autocomplete="off" data-fitting-room-target="itemType" data-action="fitting-room#changeItemType">
          <option value="jacket">Jacket or blazer</option>
          <option value="coat">Coat</option>
          <option value="trousers">Trousers</option>
        </select>
        <span class="field-help">For a pasted chart or a photo. Links work it out for themselves.</span>
      </label>

      <details class="paste-chart">
        <summary>Or paste a size chart</summary>
        <textarea rows="5" autocomplete="off" spellcheck="false" data-fitting-room-target="chartText"
                  placeholder="Size&#9;Chest&#9;Waist&#9;Sleeve&#10;40R&#9;44.5&#9;39.5&#9;25"></textarea>
        <button type="button" class="button" data-action="fitting-room#importText">Add chart</button>
      </details>

      <details class="own-jacket">
        <summary>Or use a photo and its measurements</summary>
        <p class="hint">Measure the item lying flat, or copy the numbers from the shop. The photo stays on this device;
          it's never uploaded.</p>
        <label class="photo-pick">
          <input type="file" accept="image/*" data-fitting-room-target="photoInput" data-action="change->fitting-room#pickPhoto">
          <img alt="" data-fitting-room-target="photoPreview" hidden>
          <span class="mono" data-fitting-room-target="photoLabel">+ Choose a photo (optional)</span>
        </label>
        <div class="own-sizes" data-fitting-room-target="ownSizes"></div>
        <label class="check-line">
          <input type="checkbox" autocomplete="off" data-fitting-room-target="measuredFlat">
          Widths measured flat, straight across (Fitroom doubles them)
        </label>
        <div class="fit-actions fit-actions--tight">
          <button type="button" class="button" data-action="fitting-room#addOwnSize">+ Add a size</button>
          <button type="button" class="button button--dark" data-action="fitting-room#useOwnItem">Add these measurements</button>
        </div>
      </details>

      <p class="import-error" role="alert" data-fitting-room-target="importError" hidden></p>

      <div class="fit-head fit-head--second">
        <h2>Your measurements</h2>
        <div class="segmented" role="radiogroup" aria-label="Units">
          <label><input type="radio" name="unit" autocomplete="off" value="in" checked data-fitting-room-target="unit" data-action="fitting-room#changeUnit"><span>in</span></label>
          <label><input type="radio" name="unit" autocomplete="off" value="cm" data-fitting-room-target="unit" data-action="fitting-room#changeUnit"><span>cm</span></label>
        </div>
      </div>

      <% body_parts.each do |part| %>
        <label class="field">
          <span class="field-label"><%= part[:label] %><% if part[:optional] %> <small class="mono mono--muted">optional</small><% end %></span>
          <span class="field-input">
            <input type="number" inputmode="decimal" min="0" step="0.25" autocomplete="off"
                   data-part="<%= part[:key] %>" <%= "data-optional" if part[:optional] %>
                   data-fitting-room-target="input" data-action="input->fitting-room#update">
            <span class="field-unit" data-fitting-room-target="unitLabel">in</span>
          </span>
          <span class="field-help"><%= part[:help] %></span>
        </label>
      <% end %>

      <label class="field">
        <span class="field-label">Cut</span>
        <select data-fitting-room-target="cut" data-action="fitting-room#update" autocomplete="off">
          <% Fit::CUTS.each do |key, cut| %>
            <option value="<%= key %>" <%= "selected" if key == "regular" %>><%= cut[:label] %></option>
          <% end %>
        </select>
      </label>

      <div class="fit-actions">
        <button type="button" class="button" data-action="fitting-room#fillExample">Try example numbers</button>
        <button type="button" class="button button--quiet" data-action="fitting-room#clear">Clear</button>
      </div>
    </div>

    <div class="fit-panel fit-panel--results">
      <div class="stage" data-fitting-room-target="stage">
        <canvas data-fitting-room-target="canvas" aria-label="3D display mannequin in your shape, wearing the outfit in the chosen sizes. Drag to turn it."></canvas>
        <div class="stage-top">
          <div class="segmented segmented--dark" role="radiogroup" aria-label="View">
            <label><input type="radio" name="view" value="mannequin" checked autocomplete="off" data-action="fitting-room#changeView"><span>Mannequin</span></label>
            <label><input type="radio" name="view" value="ghost" autocomplete="off" data-action="fitting-room#changeView"><span>Ghost</span></label>
            <label><input type="radio" name="view" value="fit" autocomplete="off" data-action="fitting-room#changeView"><span>Fit map</span></label>
          </div>
          <div class="segmented segmented--dark" role="radiogroup" aria-label="Pose">
            <% { "standing" => "Standing", "relaxed" => "Relaxed", "walking" => "Walking", "arms_out" => "Arms out" }.each_with_index do |(key, label), i| %>
              <label><input type="radio" name="pose" value="<%= key %>" <%= "checked" if i.zero? %> autocomplete="off" data-action="fitting-room#changePose"><span><%= label %></span></label>
            <% end %>
          </div>
          <div class="studio-start">
            <label class="studio-exact" title="Sends the shops' photos and the render to FASHN's try-on service, which deletes them afterwards">
              <input type="checkbox" checked autocomplete="off" data-fitting-room-target="exact"> Exact item (AI)
            </label>
            <button type="button" class="button button--dark" data-action="fitting-room#studioPhoto">Studio photo</button>
          </div>
          <p class="stage-note" data-fitting-room-target="stageNote"></p>
        </div>
        <div class="studio" data-fitting-room-target="studio" hidden>
          <div class="studio-frame" data-fitting-room-target="studioFrame"></div>
          <div class="studio-bar">
            <div class="segmented" role="radiogroup" aria-label="Which photo" data-fitting-room-target="studioSwitch" hidden>
              <label><input type="radio" name="studio-view" value="draped" checked data-action="fitting-room#switchStudio"><span>Measured drape</span></label>
              <label><input type="radio" name="studio-view" value="exact" data-action="fitting-room#switchStudio"><span>Exact item</span></label>
            </div>
            <p class="mono" data-fitting-room-target="studioStatus"></p>
            <a class="button" data-fitting-room-target="studioDownload" download="fitroom-studio.png" hidden>Download</a>
            <button type="button" class="button button--dark" data-action="fitting-room#closeStudio">Close</button>
          </div>
        </div>
        <div class="stage-legend" data-fitting-room-target="legend" hidden>
          <span><i class="dot dot--good"></i>Fits</span><span><i class="dot dot--tight"></i>Tight or short</span><span><i class="dot dot--loose"></i>Loose or long</span>
        </div>
        <div class="stage-photos" data-fitting-room-target="stagePhotos"></div>
        <div class="size-rows" data-fitting-room-target="sizes"></div>
      </div>
      <div class="warnings" role="alert" data-fitting-room-target="warnings" hidden></div>
      <div class="results" aria-live="polite" data-fitting-room-target="results"></div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <p>// Fitroom keeps nothing about you. Measurements are used to work out the fit, then forgotten; photos never leave your device.</p>
  <p>Sample pages and charts are made up. MIT licensed.</p>
</footer>
