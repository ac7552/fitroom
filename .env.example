# Copy to .env and fill in what you use. Fitroom runs without any of these.

# Fitroom's own virtual try-on, for the "Real clothes (AI)" button (it only shows once this is set up): FASHN
# VTON 1.5, an open-source model, on Fitroom's GPU service on Modal (script/modal/tryon_service.py), which
# also checks each picture (shape, colour, print) before the page may show it. The URL is the deployed
# "jobs" app's base URL (https://WORKSPACE--fitroom-tryon-service-jobs.modal.run, no path); the key and
# secret are a Modal proxy auth token. docs/ai-spike.md, "The service", says how.
FITROOM_TRYON_URL=
FITROOM_TRYON_KEY=
FITROOM_TRYON_SECRET=
# The model's steps for each garment (10 to 50): 20 keeps a top and pants inside a minute; 30 is a little finer.
FITROOM_TRYON_STEPS=20
# Seconds the whole AI picture may take (waking a GPU included) before it's cancelled.
FITROOM_TRYON_DEADLINE=300
# "jobs" (the default) or "sync" for the old one-request "tryon" endpoint; a URL ending in
# -tryon-tryon.modal.run is taken as the old endpoint without it. Only for the release in between.
# FITROOM_TRYON_MODE=jobs

# FASHN's hosted try-on API (https://fashn.ai), used for the same option only when the three above are empty.
FASHN_API_KEY=

# Blender 5.2+ with the MPFB extension, for path-traced studio photos and rebuilding the 3D model.
FITROOM_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender

# The studio look: photos repainted to look like a studio shot, on Fitroom's own GPU service on Modal
# (script/modal/studio_look.py). The URL is the deployed "look" endpoint; the key and secret are a Modal
# proxy auth token (Modal dashboard > Settings > Proxy Auth Tokens).
FITROOM_STUDIO_URL=
FITROOM_STUDIO_KEY=
FITROOM_STUDIO_SECRET=
