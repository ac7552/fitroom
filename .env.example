# Copy to .env and fill in what you use. Fitroom runs without any of these.

# Fitroom's own virtual try-on, for the studio photo's "Use store photos (AI)" option: open-source models on
# Fitroom's GPU service on Modal (script/modal/tryon_spike.py), which also checks each picture (shape,
# colour, print) before the page may show it. The URL is the deployed "tryon" endpoint; the key and secret
# are a Modal proxy auth token. docs/ai-spike.md says how to set it up.
FITROOM_TRYON_URL=
FITROOM_TRYON_KEY=
FITROOM_TRYON_SECRET=

# FASHN's hosted try-on API (https://fashn.ai), used for the same option only when the three above are empty.
FASHN_API_KEY=

# Blender 5.2+ with the MPFB extension, for path-traced studio photos and rebuilding the 3D model.
FITROOM_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender

# The studio look: photos repainted to look like a studio shot, on Fitroom's own GPU service on Modal
# (script/modal/studio_look.py). The URL is the deployed "look" endpoint; the key and secret are a Modal
# proxy auth token (Modal dashboard > Settings > Proxy Auth Tokens).
FITROOM_STUDIO_URL=
FITROOM_STUDIO_KEY=
FITROOM_STUDIO_SECRET=
