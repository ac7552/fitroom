# Copy to .env and fill in what you use. Fitroom runs without any of these.

# FASHN's virtual try-on, for the studio photo's "Use store photos (AI)" option (https://fashn.ai).
FASHN_API_KEY=

# Blender 5.2+ with the MPFB extension, for path-traced studio photos and rebuilding the 3D model.
FITROOM_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
