# Fitroom on a droplet. Copy to .env beside docker-compose.yml.

# Required. A long random string: `openssl rand -hex 64`. Signs cookies; nothing is stored.
SECRET_KEY_BASE=

# The droplet's domain name, for HTTPS (an A record pointing at the droplet). Leave empty to serve plain HTTP.
FITROOM_HOST=

# Optional: studio photos (Blender, Cycles on the CPU) on this droplet: 1 builds Blender into the image. Put
# the two files deploy/studio/README.md names there first. How long one render may take, in seconds.
FITROOM_STUDIO=0
FITROOM_STUDIO_TIMEOUT=600

# The AI try-on needs a GPU, so it's off on a droplet: leave FITROOM_TRYON_* and FASHN_API_KEY unset (the
# "Real clothes (AI)" button doesn't show). The photo re-drape lays the shop's own photos on the cloth instead.

# Optional models for the vision service (script/server/vision.mjs), on the CPU; empty is off.
# FITROOM_PARSE_MODEL=Xenova/segformer_b2_clothes   keeps skin, hair and backdrop off the cloth (about 30 MB)
# FITROOM_DETAILS_MODEL=Xenova/siglip-base-patch16-224   says what a photo shows (about 400 MB)
FITROOM_PARSE_MODEL=
FITROOM_DETAILS_MODEL=
