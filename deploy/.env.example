# Fitroom on a droplet. Copy to .env beside docker-compose.yml.

# Required. A long random string: `openssl rand -hex 64`. Signs cookies; nothing is stored.
SECRET_KEY_BASE=

# The droplet's domain name, for HTTPS (an A record pointing at the droplet). Leave empty to serve plain HTTP.
FITROOM_HOST=

# Optional: the AI try-on on Modal (see the repo's .env.example for what these are).
FITROOM_TRYON_URL=
FITROOM_TRYON_KEY=
FITROOM_TRYON_SECRET=
FITROOM_TRYON_STEPS=20
