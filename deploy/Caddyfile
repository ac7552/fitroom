# HTTPS in front of the Rails app. FITROOM_HOST is the droplet's domain name (its DNS A record pointing at the
# droplet); with none set, Caddy serves plain HTTP on port 80 with a self-signed certificate on 443.
{$FITROOM_HOST::80} {
	encode zstd gzip
	# The photo tools and models the server keeps itself (public/vendor, see lib/hosted.js) and the mannequin:
	# they change only with a new build, so a browser keeps them.
	@kept path /vendor/* /models/*
	header @kept Cache-Control "public, max-age=2592000"
	handle_path /vision/* {
		reverse_proxy vision:8787
	}
	reverse_proxy web:3000
}
